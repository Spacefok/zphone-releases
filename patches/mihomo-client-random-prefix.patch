diff --git a/transport/trusttunnel/random_prefix.go b/transport/trusttunnel/random_prefix.go
new file mode 100644
index 0000000..3865d85
--- /dev/null
+++ b/transport/trusttunnel/random_prefix.go
@@ -0,0 +1,43 @@
+package trusttunnel
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+	"net"
+
+	tlsC "github.com/metacubex/mihomo/component/tls"
+	"github.com/metacubex/mihomo/transport/vmess"
+)
+
+// Keep the configured prefix inside ClientHello.random and preserve the
+// remaining cryptographically generated random bytes and normal TLS validation.
+func streamTLSWithPrefix(ctx context.Context, conn net.Conn, cfg *vmess.TLSConfig, prefix string) (net.Conn, error) {
+	if prefix == "" {
+		return vmess.StreamTLSConn(ctx, conn, cfg)
+	}
+	bytes, err := hex.DecodeString(prefix)
+	if err != nil || len(bytes) == 0 || len(bytes) > 16 {
+		return nil, errors.New("client-random-prefix must contain 1 to 16 hexadecimal bytes")
+	}
+	config, err := cfg.ToStdConfig()
+	if err != nil {
+		return nil, err
+	}
+	fingerprint, _ := tlsC.GetFingerprint("chrome")
+	client := tlsC.UClient(conn, tlsC.UConfig(config), fingerprint)
+	if err := client.BuildHandshakeState(); err != nil {
+		return nil, err
+	}
+	if len(client.HandshakeState.Hello.Random) != 32 {
+		return nil, errors.New("invalid TLS client random")
+	}
+	copy(client.HandshakeState.Hello.Random, bytes)
+	if err := client.MarshalClientHello(); err != nil {
+		return nil, err
+	}
+	if err := client.HandshakeContext(ctx); err != nil {
+		return nil, err
+	}
+	return client, nil
+}
diff --git a/transport/trusttunnel/random_prefix_test.go b/transport/trusttunnel/random_prefix_test.go
new file mode 100644
index 0000000..468b0af
--- /dev/null
+++ b/transport/trusttunnel/random_prefix_test.go
@@ -0,0 +1,55 @@
+package trusttunnel
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/vmess"
+)
+
+func TestClientRandomPrefixOnWire(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = streamTLSWithPrefix(ctx, client, &vmess.TLSConfig{Host: "example.org"}, "0102030405060708")
+	}()
+	_ = server.SetReadDeadline(time.Now().Add(3 * time.Second))
+	header := make([]byte, 5)
+	if _, err := io.ReadFull(server, header); err != nil {
+		t.Fatal(err)
+	}
+	record := make([]byte, binary.BigEndian.Uint16(header[3:5]))
+	if _, err := io.ReadFull(server, record); err != nil {
+		t.Fatal(err)
+	}
+	if len(record) < 38 || record[0] != 1 {
+		t.Fatal("not a ClientHello")
+	}
+	random := record[6:38]
+	if !bytes.Equal(random[:8], []byte{1, 2, 3, 4, 5, 6, 7, 8}) {
+		t.Fatal("prefix missing from wire")
+	}
+	if bytes.Equal(random[8:], make([]byte, 24)) {
+		t.Fatal("random suffix not preserved")
+	}
+	server.Close()
+	<-done
+}
+
+func TestInvalidClientRandomPrefix(t *testing.T) {
+	for _, prefix := range []string{"0", "xx", "0000000000000000000000000000000000ff"} {
+		if _, err := streamTLSWithPrefix(context.Background(), nil, nil, prefix); err == nil {
+			t.Fatal("invalid prefix accepted")
+		}
+	}
+}
